# Copy to .env and fill in real values. Never commit .env.

# --- Required ---
DATABASE_URL=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# --- CORS: comma-separated dashboard origins ---
ALLOWED_ORIGINS=http://localhost:3000

# --- First superadmin, only used when none exists ---
DEFAULT_SUPERADMIN_EMAIL=
DEFAULT_SUPERADMIN_PASSWORD=
DEFAULT_SUPERADMIN_NAME=System Admin

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Support email ---
SUPPORT_DOMAIN=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=
SMTP_FROM_NAME=
IMAP_HOST=
IMAP_PORT=
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=
IMAP_POLL_SECONDS=

# --- Admin dashboard basic auth ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Notifications: path to the service account JSON, kept out of git ---
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
# Enables Celery and multi-process WebSockets
REDIS_URL=
NOTIFICATION_WEB_BASE_URL=
NOTIFICATION_WEB_ICON_URL=
